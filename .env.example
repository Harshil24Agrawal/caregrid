# CareGrid configuration. Copy to .env (git-ignored). All values are optional; defaults shown.

# --- LLM provider: mock | bedrock | anthropic | openai_compat ---
LLM_PROVIDER=mock

# Light tier = classification/extraction; strong tier = proposal/explanation/PR drafts.
# Leave blank to use the provider default (anthropic: claude-haiku-5-5 / claude-sonnet-5-5).
# Bedrock ids are env-only: set both (may need an inference-profile prefix like apac. / us.).
LIGHT_MODEL_ID=
STRONG_MODEL_ID=
# Embeddings are independent of LLM_PROVIDER. Thresholds are tuned on hashed.
EMBED_PROVIDER=hashed
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Free / local LLMs via any OpenAI-compatible endpoint (LLM_PROVIDER=openai_compat) ---
# Free tiers are rate limited: LLM_MAX_RPM caps requests per minute in-process, a 429 is retried once (Retry-After respected),
# and anything that still fails falls back to the deterministic path, so the app keeps working.
# Examples (check each provider's current free-tier model names; these are illustrative):
#   Gemini  OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#           OPENAI_COMPAT_API_KEY=<AI Studio key>      LIGHT_MODEL_ID=gemini-2.5-flash-lite   STRONG_MODEL_ID=gemini-2.5-flash
#   Groq    OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
#           OPENAI_COMPAT_API_KEY=<Groq key>           LIGHT_MODEL_ID=llama-3.1-8b-instant    STRONG_MODEL_ID=llama-3.3-70b-versatile
#   Ollama  OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
#           OPENAI_COMPAT_API_KEY=ollama               LIGHT_MODEL_ID=llama3.2:3b             STRONG_MODEL_ID=qwen2.5:7b
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
LLM_MAX_RPM=10

# --- Anthropic API (LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=

# --- AWS / Bedrock (LLM_PROVIDER=bedrock). Credentials come from the standard AWS chain. ---
AWS_REGION=ap-south-1
AWS_PROFILE=

# Per-tier limits (seconds). LLM_TIMEOUT_S, if set, is only the fallback for a tier without its own value.
LLM_TIMEOUT_LIGHT_S=15
LLM_TIMEOUT_STRONG_S=35
# LLM_TIMEOUT_S=

# --- Decision thresholds ---
POLICY_MIN_SCORE=0.35
PRECEDENT_MIN_SIM=0.6
TRUST_L1_STREAK=10
TRUST_L1_RATIO=0.90
TRUST_L2_REVIEWS=25
TRUST_L2_RATIO=0.95

# --- Date rules: fix "today" for deterministic demos/tests (default: system date) ---
# CAREGRID_TODAY=2026-10-08

# --- Paths (relative to repo root unless absolute) ---
DATA_DIR=data/synthetic
BRAIN_DIR=second_brain
DB_PATH=data/caregrid.sqlite

# --- Backends (cloud swap, later phases) ---
STORE_BACKEND=sqlite
COMMS_EMAIL=simulated
