# CareGrid configuration. Copy to .env (git-ignored). All values are optional; defaults shown.

# --- LLM provider: mock | bedrock | anthropic ---
LLM_PROVIDER=mock

# Light tier = classification/extraction; strong tier = proposal/explanation/PR drafts.
# Leave blank to use the provider default (anthropic: claude-haiku-5-5 / claude-sonnet-5-5).
# Bedrock ids are env-only: set both (may need an inference-profile prefix like apac. / us.).
LIGHT_MODEL_ID=
STRONG_MODEL_ID=
# Embeddings are independent of LLM_PROVIDER. Thresholds are tuned on hashed.
EMBED_PROVIDER=hashed
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Anthropic API (LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=

# --- AWS / Bedrock (LLM_PROVIDER=bedrock). Credentials come from the standard AWS chain. ---
AWS_REGION=ap-south-1
AWS_PROFILE=

# --- Decision thresholds ---
POLICY_MIN_SCORE=0.35
PRECEDENT_MIN_SIM=0.6
TRUST_L1_STREAK=10
TRUST_L1_RATIO=0.90
TRUST_L2_REVIEWS=25
TRUST_L2_RATIO=0.95

# --- Date rules: fix "today" for deterministic demos/tests (default: system date) ---
# CAREGRID_TODAY=2026-10-08

# --- Paths (relative to repo root unless absolute) ---
DATA_DIR=data/synthetic
BRAIN_DIR=second_brain
DB_PATH=data/caregrid.sqlite

# --- Backends (cloud swap, later phases) ---
STORE_BACKEND=sqlite
COMMS_EMAIL=simulated
